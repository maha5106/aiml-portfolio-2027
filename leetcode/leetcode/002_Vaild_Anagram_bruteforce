class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        #check length 
        if len(s) != len(t):
            return False

        s_list = list(s)
        t_list = list(t)

        s_list.sort()
        t_list.sort()

        s_list == t_list
        
        for i in range(len(s)):
            if s_list[i] != t_list[i]:   
                return False
        return True
